# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Runtime state. Never source, and never safe to publish.
#
# data/watcher-state.json holds real Telegram chat ids — every subscriber's, and
# the operator's. data/delegation.json holds signed EIP-7702 delegations. The
# rest are probe-script output that the app does not read. Committing any of it
# publishes other people's identifiers.
#
# The directory is created on demand, so nothing here needs to exist in the repo.
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Local scratch — screen recordings and notes for a bug being worked on.
# Never committed: these are large, and they are recordings of a real session.
problem/
